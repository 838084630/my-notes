<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="32" height="32">
  <!-- 圆形背景 -->
  <defs>
    <linearGradient id="faviconGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#764ba2;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <circle cx="16" cy="16" r="15" fill="url(#faviconGradient)"/>
  <circle cx="16" cy="16" r="12" fill="white"/>
  
  <!-- 笔记图标 -->
  <g transform="translate(16, 16)">
    <!-- 笔记本 -->
    <rect x="-4" y="-6" width="6" height="10" fill="none" stroke="#667eea" stroke-width="0.7" rx="0.4"/>
    
    <!-- 装订线 -->
    <line x1="-2" y1="-6" x2="-2" y2="4" stroke="#667eea" stroke-width="0.5" stroke-dasharray="1,1" opacity="0.7"/>
    
    <!-- 内容线 -->
    <line x1="-3" y1="-4" x2="2" y2="-4" stroke="#667eea" stroke-width="0.4" opacity="0.5"/>
    <line x1="-3" y1="-2" x2="2" y2="-2" stroke="#667eea" stroke-width="0.4" opacity="0.5"/>
    <line x1="-3" y1="0" x2="2" y2="0" stroke="#667eea" stroke-width="0.4" opacity="0.5"/>
    
    <!-- 笔 -->
    <line x1="2" y1="-3" x2="5" y2="-6" stroke="#764ba2" stroke-width="1" stroke-linecap="round"/>
    <polygon points="5,-6 6,-5 4,-3" fill="#764ba2"/>
  </g>
</svg>