<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="1200" height="630">
  <defs>
    <linearGradient id="socialGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#667eea;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#764ba2;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- 背景 -->
  <rect width="1200" height="630" fill="url(#socialGradient)"/>
  
  <!-- 白色圆圈背景 -->
  <circle cx="180" cy="315" r="100" fill="white" opacity="0.2"/>
  <circle cx="1050" cy="315" r="80" fill="white" opacity="0.15"/>
  
  <!-- Logo -->
  <g transform="translate(150, 315)">
    <circle cx="0" cy="0" r="70" fill="white"/>
    <circle cx="0" cy="0" r="55" fill="white"/>
    
    <!-- 笔记图标 -->
    <g transform="translate(0, 0)">
      <!-- 笔记本 -->
      <rect x="-18" y="-24" width="28" height="40" fill="none" stroke="#667eea" stroke-width="3" rx="2"/>
      
      <!-- 装订线 -->
      <line x1="-8" y1="-24" x2="-8" y2="16" stroke="#667eea" stroke-width="2" stroke-dasharray="3,3"/>
      
      <!-- 内容线 -->
      <line x1="-14" y1="-14" x2="8" y2="-14" stroke="#667eea" stroke-width="1.5" opacity="0.6"/>
      <line x1="-14" y1="-6" x2="8" y2="-6" stroke="#667eea" stroke-width="1.5" opacity="0.6"/>
      <line x1="-14" y1="2" x2="8" y2="2" stroke="#667eea" stroke-width="1.5" opacity="0.6"/>
      <line x1="-14" y1="10" x2="8" y2="10" stroke="#667eea" stroke-width="1.5" opacity="0.6"/>
      
      <!-- 笔 -->
      <line x1="12" y1="-10" x2="22" y2="-20" stroke="#764ba2" stroke-width="4" stroke-linecap="round"/>
      <!-- 笔尖 -->
      <polygon points="22,-20 25,-17 18,-12" fill="#764ba2"/>
    </g>
  </g>
  
  <!-- 文字 -->
  <text x="350" y="280" font-size="72" font-weight="bold" fill="white" font-family="'Arial', 'Segoe UI', sans-serif">マイノート</text>
  <text x="350" y="360" font-size="36" fill="rgba(255,255,255,0.9)" font-family="'Arial', 'Segoe UI', sans-serif">個人的なノートとドキュメント</text>
</svg>